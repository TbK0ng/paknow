# Cloud inference (optional commentary / candidate review). Select terra or deepseek.
PA_CLOUD_PROVIDER=terra
TERRA_API_KEY=
TERRA_BASE_URL=https://api.muzeai.top/v1
TERRA_MODEL=gpt-6.1-terra
TERRA_EFFORT=medium

# Legacy Chat Completions profile. Set PA_CLOUD_PROVIDER=deepseek to use it.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://www.micuapi.ai/v1
# DEEPSEEK_MODEL=deepseek-v4.1-flash
# DEEPSEEK_EFFORT=high
# Completion limit for one candidate review, including provider reasoning.
# PA_REVIEW_MAX_TOKENS=24576

# Local infrastructure.
# Local mode (default): SQLite + embedded Qdrant.
# PAKNOW_DB_URL=sqlite:///./data/paknow.db
# OBJECTS_DIR=./data/objects
# QDRANT_URL=
# Optional server mode: docker compose up -d postgres qdrant (local only).
# PA corpus sealing requires embedded Qdrant instead.
# PAKNOW_DB_URL=postgresql+psycopg://paknow:paknow@localhost:5432/paknow
# QDRANT_URL=http://localhost:6333

# Where the original PDF/EPUB files live (defaults to the repo root).
# PAKNOW_CORPUS_DIR=C:/Users/you/Desktop/sources

# Local PA evidence concurrency (1–8); does not change the cloud cap.
# PA_LOCAL_PARALLELISM=8

# Hugging Face cache: set a suitable path for this machine.
# When unset, PAknow uses the legacy Windows path E:\use_model.
# To use Hugging Face defaults instead, set HF_HOME= with no shell override.
# HF_HOME=C:/Users/you/.cache/huggingface
