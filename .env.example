# Cloud inference (answer / routing / chart observation)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Whether the cloud model accepts image input (vision). true = send images to cloud VLM.
DEEPSEEK_VISION=false

# Local infrastructure
PAKNOW_DB_URL=postgresql+psycopg://paknow:paknow@localhost:5432/paknow
QDRANT_URL=http://localhost:6333

# Where the original PDF/EPUB files live (defaults to the repo root).
# PAKNOW_CORPUS_DIR=C:/Users/you/Desktop/sources

# Local model cache dir (defaults to ./data/models)
HF_HOME=
